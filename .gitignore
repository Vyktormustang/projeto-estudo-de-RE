# --- ROMs (nunca versionar: nem a comercial, nem cópias de trabalho) ---
rom/*.gba
rom_mod/*.gba
*.gba
!tests/fixtures/*.gba
deliver/
*.pyc
__pycache__/

# --- build do emulador (compilar local: make -C tools/gba_shim) ---
tools/gba_shim/build/
tools/gba_shim/build/mgba-src/
*.o
*.so

# --- logs/artefatos gerados localmente ---
logs/gba_emu_runs.jsonl
logs/*.log
emu/run/
# relatórios de mod são evidência versionada (reports/mod_*) — não ignorar

# --- FORJA ---
forja/web/node_modules/
forja/web/dist/
forja/dist/
forja/web/.vite/
*.apk
!forja/**/*.apk

# --- SPEAKNATURAL ---
speaknatural/backend/.venv/
speaknatural/backend/data/
speaknatural/backend/**/__pycache__/
speaknatural/backend/.pytest_cache/
speaknatural/frontend/node_modules/
speaknatural/frontend/dist/
speaknatural/frontend/android/.gradle/
speaknatural/frontend/android/build/
speaknatural/frontend/android/app/build/
speaknatural/frontend/android/local.properties
speaknatural/frontend/android/app/src/main/assets/public/
speaknatural/frontend/android/app/src/main/assets/capacitor.config.json
speaknatural/frontend/android/app/src/main/assets/capacitor.plugins.json
speaknatural/build-out/
