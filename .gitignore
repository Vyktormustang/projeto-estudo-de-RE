# --- ROMs (nunca versionar: nem a comercial, nem cópias de trabalho) ---
rom/*.gba
rom_mod/*.gba
*.gba
!tests/fixtures/*.gba
deliver/
*.pyc
__pycache__/

# --- build do emulador (compilar local: make -C tools/gba_shim) ---
tools/gba_shim/build/
tools/gba_shim/build/mgba-src/
*.o
*.so

# --- logs/artefatos gerados localmente ---
logs/gba_emu_runs.jsonl
logs/*.log
emu/run/
# relatórios de mod são evidência versionada (reports/mod_*) — não ignorar

# --- FORJA ---
forja/web/node_modules/
forja/web/dist/
forja/dist/
forja/web/.vite/
*.apk
!forja/**/*.apk

# --- ambiente de teste local ---
.venv/
reports/v42/*INCOMPLETA*
