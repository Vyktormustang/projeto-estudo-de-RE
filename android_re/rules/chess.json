{
  "label": "Xadrez — funcionalidades alvo",
  "rules": [
    {
      "id": "chess.engine.uci",
      "name": "Motor UCI (bestmove/uciok)",
      "patterns": [
        "bestmove",
        "uciok",
        "go depth",
        "position fen"
      ]
    },
    {
      "id": "chess.engine.native",
      "name": "Motor em biblioteca nativa",
      "patterns": [
        "Stockfish",
        "EngineLoader",
        "loadEngine",
        "nativeEval"
      ]
    },
    {
      "id": "chess.fen",
      "name": "FEN (posição serializada)",
      "patterns": [
        "setFen",
        "fromFen",
        "toFen",
        "fenString",
        "currentFen"
      ]
    },
    {
      "id": "chess.pgn",
      "name": "PGN (notação de partida)",
      "patterns": [
        "pgnGame",
        "loadPgn",
        "PgnReader",
        "[Event "
      ]
    },
    {
      "id": "chess.clock",
      "name": "Relógio/incremento",
      "patterns": [
        "TimeControl",
        "incrementMillis",
        "ClockView",
        "flagFall"
      ]
    },
    {
      "id": "chess.premove",
      "name": "Pre-move",
      "patterns": [
        "premove",
        "PreMove",
        "queuedMove"
      ]
    },
    {
      "id": "chess.board",
      "name": "Renderização do tabuleiro",
      "patterns": [
        "BoardView",
        "ChessBoard",
        "PieceSet",
        "SquareView"
      ]
    },
    {
      "id": "chess.moves",
      "name": "Geração de lances/legalidade",
      "patterns": [
        "generateLegalMoves",
        "MoveGenerator",
        "isLegalMove",
        "perft"
      ]
    },
    {
      "id": "chess.puzzle",
      "name": "Puzzles/táticas",
      "patterns": [
        "PuzzleRush",
        "puzzleId",
        "TacticPuzzle",
        "solvePuzzle"
      ]
    },
    {
      "id": "chess.lesson",
      "name": "Lições/curso",
      "patterns": [
        "LessonActivity",
        "MoveTrainer",
        "courseId"
      ]
    },
    {
      "id": "chess.online",
      "name": "Jogo online (matchmaking/socket)",
      "patterns": [
        "matchmaking",
        "GameSocket",
        "seekGame",
        "gameId"
      ]
    },
    {
      "id": "chess.rating",
      "name": "Rating/Elo/Glicko",
      "patterns": [
        "glicko",
        "ratingDeviation",
        "eloRating",
        "kFactor"
      ]
    },
    {
      "id": "chess.analysis",
      "name": "Análise pós-jogo/avaliação",
      "patterns": [
        "GameReview",
        "evaluationBar",
        "AccuracyReport",
        "BlunderReport",
        "brilliantMove"
      ]
    }
  ]
}
