#!/usr/bin/env python3
import sys
from _common import cc
args = [a for a in sys.argv[1:] if a != "-quiet"]
if "-" in args and "-x" not in args:
    k = len(args) - 1 - args[::-1].index("-")   # o ULTIMO "-" e a entrada
    args[k:k+1] = ["-x", "c", "-"]
if not any(a in ("-S","-c","-E","-M","-MM") for a in args):
    args.insert(0, "-S")
sys.exit(cc(args))
